APP_NAME=Omni-Channel Task Manager
ENVIRONMENT=production
DOMAIN_NAME=tasks-bot.space
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=replace-with-strong-32-char-postgres-password
POSTGRES_DB=taskmanager
DATABASE_URL=postgresql+asyncpg://taskmanager:replace-with-strong-32-char-postgres-password@postgres:5432/taskmanager
SYNC_DATABASE_URL=postgresql+psycopg2://taskmanager:replace-with-strong-32-char-postgres-password@postgres:5432/taskmanager
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
TELEGRAM_BOT_TOKEN=123456789:AAE_replace_with_real_botfather_token
TELEGRAM_BOT_USERNAME=ai_task_mgr_bot
TELEGRAM_WEBHOOK_URL=https://tasks-bot.space/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-16-output
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
VOICE_TEMP_DIR=/tmp/voice
ALLOW_DEV_AUTH=false
AUTH_MAX_AGE_SECONDS=86400
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws/tasks
VITE_TELEGRAM_BOT_USERNAME=ai_task_mgr_bot
VITE_ALLOW_DEV_AUTH=false
